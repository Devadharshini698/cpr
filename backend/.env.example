MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=imsr
MYSQL_PASSWORD=
DB_NAME=imsr
MYSQL_SSL=false
JWT_SECRET=replace-with-a-random-secret
# CPU-only core reports work with this disabled.
ENABLE_OLLAMA_DEBRIEF=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
# Optional live audio transcription and speaker diarization. Keep HF_TOKEN private.
HF_TOKEN=
DEBRIEF_WHISPER_MODEL=medium
DIARIZATION_BACKEND=pyannote
# Keep legacy-3.1 until Community-1 is installed in a separate pyannote 4 environment.
DIARIZATION_MODEL=legacy-3.1
# Required only when DIARIZATION_MODEL=community-1 (absolute path to python.exe).
DEBRIEF_COMMUNITY_PYTHON=
DEBRIEF_COMMUNITY_HF_HOME=
# Community-1 defaults to CPU. Set cuda only after testing sufficient VRAM.
DEBRIEF_COMMUNITY_DEVICE=cpu
# Optional for controlled recordings with a known number of distinct voices.
DEBRIEF_EXPECTED_SPEAKERS=
# A shared persistent volume is required when API/worker run on different hosts.
DEBRIEF_REPORT_DIR=debriefing/output/reports
# Demo accounts must be explicitly enabled for local demonstrations.
ENABLE_DEMO_USERS=false
COOKIE_SECURE=false
